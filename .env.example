MODEL=huggingface.co/mlx-community/qwen3-0.6b-4bit:latest
# Service C uses a colon-free alias; the weights are identical.
SGLANG_MODEL=mlx-community/Qwen3-0.6B-4bit
PORT=8088
# For native `npm start`; Compose uses model-runner.docker.internal.
UPSTREAM_BASE_URL=http://127.0.0.1:12434/engines/vllm-metal/v1
RESPONSES_MODE=service
RUNTIME_PROFILE=dmr-metal
# For the full Core profile use vllm-metal with port 18001 or sglang-metal with 18002.
# Public authentication is opt-in for this loopback development deployment.
# API_KEY=replace-with-a-random-development-key
# Alternatively map distinct keys to tenant IDs: API_KEYS={"key-a":"tenant-a"}
# Engine credentials are configured separately and never copied from client keys.
# UPSTREAM_API_KEY=
# Compose selects credentials per engine: DMR_UPSTREAM_API_KEY,
# NATIVE_UPSTREAM_API_KEY, and SGLANG_UPSTREAM_API_KEY.
RESPONSES_MAX_CONCURRENT=4
RESPONSES_MAX_CONCURRENT_PER_TENANT=2
CONTEXT_LENGTH=32768
# Standalone gateway identity; Compose defines these separately for each service.
SERVICE_ID=docker
SERVICE_NAME=Docker Model Runner
SNAPSHOT_FILE=service-status.json
# For a standalone comparison gateway, use fixed peer gateway addresses:
# NATIVE_SERVICE_BASE_URL=http://127.0.0.1:8089
# SGLANG_SERVICE_BASE_URL=http://127.0.0.1:8090
